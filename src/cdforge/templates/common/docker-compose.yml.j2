{% if needs_service_stack %}
# Backing services for local development. This file is NOT part of the devcontainer
# definition (devcontainer.json builds a single plain container). Bring it up from *inside*
# the devcontainer with the in-container Docker daemon:
#
#     docker compose up -d
#
# The services publish on 127.0.0.1 only; the app reaches them at `localhost` (see
# `.env.example`). `docker_mode` is `sysbox` or `privileged` for this project precisely so
# this daemon exists.
services:
{% if db_is_server %}
  db:
    image: {{ db_image }}
    restart: unless-stopped
    environment:
{% if database == 'postgres' %}
      POSTGRES_DB: {{ db_name }}
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
{% else %}
      MARIADB_DATABASE: {{ db_name }}
      MARIADB_USER: {{ db_user }}
      MARIADB_PASSWORD: {{ db_password }}
      MARIADB_ROOT_PASSWORD: {{ db_password }}
{% endif %}
    volumes:
      - db-data:/var/lib/{{ 'postgresql/data' if database == 'postgres' else 'mysql' }}
    ports:
      - "127.0.0.1:{{ db_port }}:{{ db_port }}"
{% endif %}
{% if include_celery %}
  redis:
    image: redis:7
    restart: unless-stopped
    ports:
      - "127.0.0.1:6379:6379"
{% endif %}
{% if db_is_server %}

volumes:
  db-data:
{% endif %}
{% endif %}
