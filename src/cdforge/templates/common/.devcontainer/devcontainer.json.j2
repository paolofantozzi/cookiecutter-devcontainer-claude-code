{
  "name": {{ project_name | tojson }},
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "{{ remote_user }}",
  "features": {
{% if enable_docker %}
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest"
    },
{% endif %}
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
{% for feature_id, feature_opts in extra_features.items() %}
    ,"{{ feature_id }}": {{ feature_opts | tojson }}
{% endfor %}
  },
{% if gpu_enabled %}
  "hostRequirements": {
    "gpu": "optional"
  },
{% endif %}
{% if vscode_extensions %}
  "customizations": {
    "vscode": {
      "extensions": {{ vscode_extensions | tojson }}
    }
  },
{% endif %}
{% if forward_ports %}
  "forwardPorts": {{ forward_ports | tojson }},
{% endif %}
{% if run_args %}
  "runArgs": {{ run_args | tojson }},
{% endif %}
{% if post_start_command %}
  "postStartCommand": {{ post_start_command | tojson }},
{% endif %}
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/claude-home,target=/home/{{ remote_user }}/.claude,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/{{ remote_user }}/.claude",
    "CDFORGE_DEVCONTAINER": "1"
  },
  "initializeCommand": "mkdir -p \"${localWorkspaceFolder}/.devcontainer/claude-home\"",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
