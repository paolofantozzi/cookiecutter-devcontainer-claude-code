[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{% if license_id != 'None' %}
license = { text = "{{ license_id }}" }
{% endif %}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = [
    "typer>=0.15",
]

[project.scripts]
{{ cli_command_name }} = "{{ package_import_name }}.cli:app"

[build-system]
requires = ["uv_build>=0.11.26,<0.12.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.8",
{% if include_mypy %}
    "mypy>=1.13",
{% endif %}
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version.replace('.', '') }}"

[tool.ruff.format]
quote-style = "single"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.ruff.lint.isort]
force-single-line = true

[tool.pytest.ini_options]
testpaths = ["tests"]
