{% if use_compose and compose_file_location == 'devcontainer' %}
# Compose *override* generated by cdforge, for a project that already had its own
# docker-compose.yml. Dev Containers loads both files, so the project keeps its own
# services and this one adds the devcontainer itself (the `app` service, which is what
# Claude Code runs in) plus the backing services it needs, as siblings on the same
# network. The `app` container is NOT privileged and mounts only this workspace, with
# `.devcontainer` read-only so the sandbox definition cannot be rewritten from inside.
# Relative paths below resolve against the project root — the directory of the *first*
# compose file — not against this one.
{% include "compose.fragment.yml.j2" %}
{% endif %}
