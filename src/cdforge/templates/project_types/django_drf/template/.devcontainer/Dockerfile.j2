FROM {{ base_image }}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
{% for package in extra_apt_packages %}
        {{ package }} \
{% endfor %}
        git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

USER {{ remote_user }}
